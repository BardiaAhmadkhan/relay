# Server-side configuration. The illustrated desk runs with these fields empty.
HOST=127.0.0.1
PORT=4188
RELAY_UPSTREAM=
RELAY_UPSTREAM_TOKEN=
RELAY_WEB_PASSWORD=
RELAY_WORKSHOP_NAME=
RELAY_HTTPS=0

# HTTPS storefront root or localized market path. The storefront must display CAD.
RELAY_STORE_URL=
RELAY_STORE_NAME=
# Enable the customer-facing, per-rider intake on a connected installation.
RELAY_RIDER_ACCESS=0
RELAY_RIDER_STARTS_PER_HOUR=30

# Use persistent, private storage for the catalog and credit ledger.
# Defaults to .local/trade-in.sqlite below the application root.
RELAY_TRADE_DB=
RELAY_WORKSHOP_ID=primary
# Optional resale ratios for a signed appearance grade, expressed from 0 to 1.
RELAY_RESALE_GRADE_A=
RELAY_RESALE_GRADE_B=
RELAY_RESALE_GRADE_C=
RELAY_RESALE_GRADE_D=

# Optional Shopify gift cards for live checkout. Both settings belong to the server.
RELAY_SHOPIFY_ADMIN_DOMAIN=
RELAY_SHOPIFY_ADMIN_TOKEN=
