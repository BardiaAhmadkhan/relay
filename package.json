{
  "name": "relay-inspection-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "catalog:sync": "node --env-file-if-exists=.env scripts/sync-catalog.mjs",
    "verify": "npm test && npm run build && npm run smoke && npm run check:release",
    "smoke": "node scripts/smoke-build.mjs",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
